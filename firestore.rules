rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'FACULTY_ADMIN'];
    }

    function isVolunteer() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['VOLUNTEER', 'ADMIN'];
    }

    match /users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && (request.auth.uid == uid || isAdmin());
    }

    match /events/{eventId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || isVolunteer());
      allow delete: if isAdmin();
    }

    match /attendances/{attId} {
      allow read: if isAuth();
      allow create: if isVolunteer();
      allow update, delete: if isAdmin();
    }

    match /updates/{updateId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
  }
}